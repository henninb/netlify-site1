# Copy to .env and fill in values. Never commit .env.
# On Netlify, set these in Site settings → Environment variables.

# Required — HUMAN application ID (iframe + Enforce API host)
HUMAN_APP_ID=

# Required for Enforce API calls on submit (server-side only; never sent to the browser)
ENFORCER_AUTH_TOKEN=

# HUMAN challenge iframe origin (optional override)
HUMAN_IFRAME_ORIGIN=https://iframe.hsprotect.net

PORT=3000

# iframe-only (no edge enforcer): do not require cgp=1
ENFORCE_STRICT_CGP=0

# Set to 0 to disable Enforce API on submit (submit will return 503)
ENFORCE_API_ON_SUBMIT=1

# Comma-separated trusted headers for real client IP (default: x-forwarded-for,x-real-ip,cf-connecting-ip,true-client-ip,x-client-ip)
# TRUSTED_IP_HEADERS=x-forwarded-for,x-real-ip
